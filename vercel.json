{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "outputDirectory": "dist",
  "regions": ["gru1"],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path+", "destination": "/api?__p=:path+" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
